{
  "name": "krasnopars-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:extension": "tsc -p extension/tsconfig.json && vite build --config extension/vite.config.ts && vite build --config extension/background.vite.config.ts && node extension/scripts/manifests.mjs",
    "test:extension": "node --test extension/*.test.mjs",
    "package:extension": "npm run build:extension && node extension/scripts/package.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
